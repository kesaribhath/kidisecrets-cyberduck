#define C_CREAM_BG  0xFFBB
#define C_CREAM_DOT 0xFDD3
#define C_SKY_LACE  0x3DFF
#define C_SKY_DARK  0x0398
#define C_SUN_YEL   0xFF08
#define C_GREEN     0x4F2F
#define C_ROSE      0xFE79
#define C_PURPLE    0xA29E
#define C_INK       0x18E3

