void handleDeckTouch(int tx, int ty) {
  if (confirmSleep) {
    if (ty >= 136 && ty <= 180) {
      if (tx >= 46 && tx <= 152) { confirmSleep = false; enterDeckSleep(); return; }
      if (tx >= 168 && tx <= 274) { confirmSleep = false; drawDeck(); return; }
    } else if (ty < 46 || ty > 194) {
      confirmSleep = false;
      drawDeck();
    }
    return;
  }

  if (ty < 33) {
    if (tx >= 110 && tx < 144) {
      confirmSleep = true;
      drawDeck();
      return;
    }
    if (tx >= 147 && tx < 204) curTab = TAB_KB;
    else if (tx >= 204 && tx < 260) curTab = TAB_APPS;
    else if (tx >= 260) curTab = TAB_PAD;
    drawDeck();
    return;
  }

  if (curTab == TAB_KB) {
    const char* r0 = symMode ? "1234567890" : (shiftMode ? "QWERTYUIOP" : "qwertyuiop");
    const char* r1 = symMode ? "-/:;()!?@ " : (shiftMode ? "ASDFGHJKL"  : "asdfghjkl");
    const char* r2 = symMode ? ".,'*+=#"   : (shiftMode ? "ZXCVBNM"    : "zxcvbnm");
    if (ty >= 64 && ty < 104) {
      int i = (tx - 5) / 31;
      if (i >= 0 && i < 10) { sendPkt(1, r0[i]); previewStr += r0[i]; if (shiftMode && !symMode) shiftMode = false; }
    } else if (ty >= 106 && ty < 146) {
      int i = (tx - 18) / 31;
      if (i >= 0 && i < 9) { sendPkt(1, r1[i]); previewStr += r1[i]; if (shiftMode && !symMode) shiftMode = false; }
    } else if (ty >= 148 && ty < 190) {
      if (tx < 40) shiftMode = !shiftMode;
      else if (tx >= 270) { sendPkt(2, 0); if (previewStr.length() > 0) previewStr.remove(previewStr.length() - 1); }
      else { int i = (tx - 42) / 32; if (i >= 0 && i < 7) { sendPkt(1, r2[i]); previewStr += r2[i]; if (shiftMode && !symMode) shiftMode = false; } }
    } else if (ty >= 190) {
      if (tx < 66) symMode = !symMode;
      else if (tx < 236) { sendPkt(1, ' '); previewStr += ' '; }
      else { sendPkt(3, 0); previewStr = ""; }
    }
    drawDeck();
    return;
  }

  if (curTab == TAB_APPS) {
    int c = (tx - 8) / 103, r = (ty - 40) / 62;
    int idx = r * 3 + c;
    if (r >= 0 && r < 3 && c >= 0 && c < 3) {
      activeAppIdx = (uint8_t)idx;
      sendPkt(5, (char)idx);
      drawDeck();
    }
    return;
  }

  if (curTab == TAB_PAD) {
    if (tx >= 54 && tx <= 96 && ty >= 54 && ty <= 96) sendPkt(4, 0);
    else if (tx >= 54 && tx <= 96 && ty >= 150 && ty <= 192) sendPkt(4, 1);
    else if (tx >= 8 && tx <= 50 && ty >= 102 && ty <= 144) sendPkt(4, 2);
    else if (tx >= 100 && tx <= 142 && ty >= 102 && ty <= 144) sendPkt(4, 3);
    else if (tx >= 54 && tx <= 96 && ty >= 102 && ty <= 144) sendPkt(3, 0);
    else if (tx >= 164) {
      if (ty >= 182) {
        if (tx < 210) sendPkt(5, 1);
        else if (tx < 259) sendPkt(1, '0');
        else sendPkt(2, 0);
      } else {
        int c = (tx - 164) / 49, r = (ty - 44) / 46;
        if (r >= 0 && r < 3 && c >= 0 && c < 3) sendPkt(1, (char)('1' + r * 3 + c));
      }
    }
  }
}

void setup() {
  Serial.begin(115200);
  pinMode(0, INPUT_PULLUP);
  lastActivityMs = millis();
  prefs.begin("kidideck_kb32", false);
  deckRot = prefs.getUChar("drot", 1);

  tft.init();
  tft.setRotation(deckRot);
  tft.setBrightness(225);

#ifndef DECK_ES3C28P_S3
  tft.initAllTouchBuses();
#endif
  if (prefs.getBool("dcal2", false)) {
    deckTouchBus = prefs.getUChar("dbus", 0);
    calSwap = prefs.getBool("cswap", true);
    calX1 = prefs.getShort("cx1", 3800);
    calY1 = prefs.getShort("cy1", 300);
    calX2 = prefs.getShort("cx2", 300);
    calY2 = prefs.getShort("cy2", 3800);
#ifndef DECK_ES3C28P_S3
    tft.selectTouchBus(deckTouchBus);
#endif
  } else {
    runDeckTouchAlign();
  }

  WiFi.mode(WIFI_STA);
  esp_wifi_set_channel(1, WIFI_SECOND_CHAN_NONE);
  if (esp_now_init() == ESP_OK) {
    esp_now_peer_info_t peer = {};
    memcpy(peer.peer_addr, BROADCAST_MAC, 6);
    peer.channel = 1;
    peer.encrypt = false;
    esp_now_add_peer(&peer);
  }
  drawDeck();
  sendPkt(6, (char)readDeckBatPct());
}

void loop() {
  uint32_t now = millis();
  int tx = 0, ty = 0;
  if (getAlignedTouch(tx, ty)) {
    lastActivityMs = now;
    if (deckDimmed) { tft.setBrightness(225); deckDimmed = false; }
    if (now - lastTouchMs > 160) {
      lastTouchMs = now;
      handleDeckTouch(tx, ty);
    }
  }
  if (digitalRead(0) == LOW) {
    if (bootHoldStart == 0) bootHoldStart = now;
    else if (now - bootHoldStart > 1400) {
      bootHoldStart = 0;
      enterDeckSleep();
    }
  } else {
    bootHoldStart = 0;
  }
  if (!deckDimmed && (now - lastActivityMs > 90000UL)) {
    deckDimmed = true;
    tft.setBrightness(40);
  }
  if (now - lastActivityMs > 300000UL) {
    enterDeckSleep();
  }
  if (now - lastBatSendMs > 4000) {
    lastBatSendMs = now;
    sendPkt(6, (char)readDeckBatPct());
  }
  delay(15);
}
