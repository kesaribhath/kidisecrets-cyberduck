int16_t calY1 = 300,  calY2 = 3800;
bool calSwap = true;

const uint8_t* activeFontPtr = nullptr;
void useFont(const uint8_t* f) {
  if (activeFontPtr == f) return;
  if (activeFontPtr != nullptr) tft.unloadFont();
  tft.loadFont(f);
  activeFontPtr = f;
}

static uint16_t sprBuf[24 * 24];
void drawRleSprite(int x, int y, int w, int h, const uint16_t* rle) {
  int total = w * h, idx = 0, r = 0;
  while (idx < total) {
    uint16_t cnt = pgm_read_word(&rle[r++]);
    if (cnt == 0) break;
    uint16_t col = pgm_read_word(&rle[r++]);
    int end = min(total, idx + (int)cnt);
    while (idx < end) sprBuf[idx++] = col;
  }
  tft.pushImage(x, y, w, h, sprBuf, (uint16_t)TR_COL);
}

int readDeckBatPct() {
  uint32_t mv = analogReadMilliVolts(BAT_ADC_PIN) * 2;
  if (mv < 2500) return 100;
  return map((long)constrain((int)mv, 3300, 4200), 3300, 4200, 0, 100);
}

void sendPkt(uint8_t kind, char ch) {
  KidiPacket p = {kind, ch};
  esp_now_send(BROADCAST_MAC, (uint8_t*)&p, sizeof(p));
}

void enterDeckSleep() {
  tft.fillRoundRect(46, 94, 228, 52, 12, C_INK);
  tft.drawRoundRect(46, 94, 228, 52, 12, C_SUN_YEL);
  useFont(FREDOKA_SM);
  tft.setTextDatum(MC_DATUM);
  tft.setTextColor(TFT_WHITE);
  tft.drawString("Sleeping... Press BOOT to wake", 160, 120);
  delay(800);
  while (digitalRead(0) == LOW) delay(20);
  delay(80);
  tft.setBrightness(0);
  tft.sleep();
  esp_now_deinit();
  WiFi.disconnect(true);
  WiFi.mode(WIFI_OFF);
  esp_sleep_enable_ext0_wakeup(GPIO_NUM_0, 0);
  esp_deep_sleep_start();
}

void drawPolka() {
  tft.fillScreen(C_CREAM_BG);
  for (int y = 8; y < 240; y += 26) {
    int off = ((y / 26) % 2) * 13;
    for (int x = 8 + off; x < 320; x += 26) tft.fillCircle(x, y, 4, C_CREAM_DOT);
  }
}

void drawBevelKey(int x, int y, int w, int h, uint16_t fill, uint16_t border, uint16_t shadow) {
  tft.fillRoundRect(x, y + 2, w, h, 7, shadow);
  tft.fillRoundRect(x, y, w, h, 7, fill);
  tft.drawRoundRect(x, y, w, h, 7, border);
}

bool readDeckRawValidated(uint16_t &rx, uint16_t &ry, int samples = 2) {
#ifdef DECK_ES3C28P_S3
  (void)samples;
  return tft.getTouchRaw(&rx, &ry);
#else
  uint32_t sx = 0, sy = 0;
  uint16_t prevX = 0, prevY = 0;
  for (int i = 0; i < samples; i++) {
    uint16_t x = 0, y = 0;
    if (!tft.getTouchRaw(&x, &y)) return false;
    if (x <= 80 || x >= 4015 || y <= 80 || y >= 4015) return false;
    if (i > 0) {
      if (abs((int)x - (int)prevX) > 260 || abs((int)y - (int)prevY) > 260) return false;
    }
    prevX = x; prevY = y;
    sx += x; sy += y;
    if (i + 1 < samples) delay(5);
  }
  rx = (uint16_t)(sx / samples);
  ry = (uint16_t)(sy / samples);
  return true;
#endif
}

bool waitSingleDeckRawTap(uint16_t &rx, uint16_t &ry, bool autoProbeBus) {
  uint16_t dummyX = 0, dummyY = 0;
#ifdef DECK_ES3C28P_S3
  (void)autoProbeBus;
  while (tft.getTouchRaw(&dummyX, &dummyY)) delay(20);
  while (true) {
    if (digitalRead(0) == LOW) return false;
    if (tft.getTouchRaw(&rx, &ry)) {
      uint16_t sx = rx, sy = ry;
      delay(70);
      while (tft.getTouchRaw(&dummyX, &dummyY)) delay(20);
      rx = sx; ry = sy;
      return true;
    }
    delay(18);
  }
#else
  uint32_t relStart = millis();
  while (millis() - relStart < 800) {
    if (!tft.getTouchRaw(&dummyX, &dummyY) || dummyX <= 80 || dummyX >= 4015) break;
    delay(20);
  }
  uint8_t probeBus = deckTouchBus;
  while (true) {
    if (digitalRead(0) == LOW) return false;
    if (autoProbeBus) {
      probeBus = (probeBus + 1) & 1;
      tft.selectTouchBus(probeBus);
    }
    if (readDeckRawValidated(rx, ry, autoProbeBus ? 4 : 3)) {
      if (autoProbeBus) {
        deckTouchBus = probeBus;
        tft.selectTouchBus(deckTouchBus);
      }
      uint32_t waitRel = millis();
      while (millis() - waitRel < 1500 && tft.getTouchRaw(&dummyX, &dummyY) && dummyX > 80 && dummyX < 4015) {
        delay(20);
      }
      delay(60);
      return true;
    }
    delay(18);
  }
#endif
}

void runDeckTouchAlign() {
  pinMode(0, INPUT_PULLUP);
#ifndef DECK_ES3C28P_S3
  tft.initAllTouchBuses();
#endif
  uint16_t rx1 = 0, ry1 = 0, rx2 = 0, ry2 = 0, rx3 = 0, ry3 = 0;

  tft.fillScreen(0x4190);
  useFont(FREDOKA_MD);
  tft.setTextDatum(MC_DATUM);
  tft.setTextColor(TFT_WHITE);
  tft.drawString("Deck Touch Align (1/3)", 160, 96);
  useFont(FREDOKA_SM);
  tft.drawString("Tap the RED circle (Top-Left)", 160, 122);
  tft.setTextColor(C_SUN_YEL);
#ifndef DECK_ES3C28P_S3
  tft.drawString("Auto-detecting 25/32/39 & 14/13/12...", 160, 148);
#endif
  tft.setTextColor(0xD69A);
  tft.drawString("(Press BOOT button to skip)", 160, 174);
  tft.fillCircle(36, 36, 15, TFT_RED);
  tft.drawCircle(36, 36, 17, TFT_WHITE);
  if (!waitSingleDeckRawTap(rx1, ry1, true)) {
#ifndef DECK_ES3C28P_S3
    tft.selectTouchBus(deckTouchBus);
#endif
    return;
  }

  tft.fillScreen(0x4190);
  useFont(FREDOKA_MD);
  tft.setTextColor(TFT_WHITE);
  tft.drawString("Deck Touch Align (2/3)", 160, 96);
  useFont(FREDOKA_SM);
  tft.drawString("Tap the BLUE circle (Top-Right)", 160, 122);
  tft.setTextColor(C_SUN_YEL);
#ifndef DECK_ES3C28P_S3
  tft.drawString(deckTouchBus == 0 ? "Detected Bus: 25/32/39" : "Detected Bus: 14/13/12", 160, 150);
#endif
  tft.fillCircle(284, 36, 15, C_SKY_LACE);
  tft.drawCircle(284, 36, 17, TFT_WHITE);
  if (!waitSingleDeckRawTap(rx2, ry2, false)) return;

  tft.fillScreen(0x4190);
  useFont(FREDOKA_MD);
  tft.setTextColor(TFT_WHITE);
  tft.drawString("Deck Touch Align (3/3)", 160, 96);
  useFont(FREDOKA_SM);
  tft.drawString("Tap the GREEN circle (Bottom-Right)", 160, 122);
  tft.fillCircle(284, 204, 15, C_GREEN);
  tft.drawCircle(284, 204, 17, TFT_WHITE);
  if (!waitSingleDeckRawTap(rx3, ry3, false)) return;

  calSwap = abs((int)ry2 - (int)ry1) > abs((int)rx2 - (int)rx1);
  if (calSwap) {
    calX1 = (int16_t)ry1; calX2 = (int16_t)ry2;
    calY1 = (int16_t)rx2; calY2 = (int16_t)rx3;
  } else {
    calX1 = (int16_t)rx1; calX2 = (int16_t)rx2;
    calY1 = (int16_t)ry2; calY2 = (int16_t)ry3;
  }
#ifdef DECK_ES3C28P_S3
  if (abs(calX2 - calX1) < 30) calX2 = calX1 + 248;
  if (abs(calY2 - calY1) < 30) calY2 = calY1 + 168;
#else
  if (abs(calX2 - calX1) < 200) calX2 = calX1 + 2600;
  if (abs(calY2 - calY1) < 200) calY2 = calY1 + 2600;
#endif

  prefs.putBool("dcal2", true);
  prefs.putUChar("dbus", deckTouchBus);
  prefs.putBool("cswap", calSwap);
  prefs.putShort("cx1", calX1); prefs.putShort("cy1", calY1);
  prefs.putShort("cx2", calX2); prefs.putShort("cy2", calY2);
#ifndef DECK_ES3C28P_S3
  tft.selectTouchBus(deckTouchBus);
#endif
}

bool getAlignedTouch(int &tx, int &ty) {
  uint16_t rx = 0, ry = 0;
  if (!readDeckRawValidated(rx, ry, 2)) return false;
  int rawX = calSwap ? (int)ry : (int)rx;
  int rawY = calSwap ? (int)rx : (int)ry;
  tx = constrain((int)map(rawX, calX1, calX2, 36, 284), 0, 319);
  ty = constrain((int)map(rawY, calY1, calY2, 36, 204), 0, 239);
  return true;
}

