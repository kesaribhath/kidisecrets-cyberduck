#ifdef BOARD_ES3C28P_S3
bool readJpgDims(fs::FS &fs, const char* path, int &w, int &h) {
  File f = fs.open(path);
  if (!f) return false;
  uint8_t sig[2];
  if (f.read(sig, 2) != 2 || sig[0] != 0xFF || sig[1] != 0xD8) { f.close(); return false; }
  while (f.available()) {
    int b = f.read();
    if (b < 0) break;
    if (b != 0xFF) continue;
    int m = f.read();
    while (m == 0xFF && f.available()) m = f.read();
    if (m < 0 || m == 0xD9 || m == 0xDA) break;
    if (m >= 0xC0 && m <= 0xC3 && m != 0xC1) {
      uint8_t lb[2], hdr[5];
      if (f.read(lb, 2) == 2 && f.read(hdr, 5) == 5) {
        h = (hdr[1] << 8) | hdr[2];
        w = (hdr[3] << 8) | hdr[4];
        f.close();
        return (w > 0 && h > 0);
      }
      break;
    }
    uint8_t lb[2];
    if (f.read(lb, 2) != 2) break;
    uint16_t segLen = (lb[0] << 8) | lb[1];
    if (segLen < 2) break;
    f.seek(f.position() + segLen - 2);
  }
  f.close();
  return false;
}
#endif

bool drawSdJpgFit(const char* path, int bx, int by, int bw, int bh) {
#ifdef BOARD_ES3C28P_S3
  if (!sdReady || !SD_MMC.exists(path)) return false;
  int jw = 0, jh = 0;
  float sc = 1.0f;
  int dx = bx, dy = by;
  if (readJpgDims(SD_MMC, path, jw, jh) && jw > 0 && jh > 0) {
    sc = min((float)bw / (float)jw, (float)bh / (float)jh);
    if (sc > 4.0f) sc = 4.0f;
    int dw = max(1, (int)(jw * sc));
    int dh = max(1, (int)(jh * sc));
    dx = bx + (bw - dw) / 2;
    dy = by + (bh - dh) / 2;
  }
  return tft.drawJpgFile((fs::FS&)SD_MMC, path, dx, dy, bw, bh, 0, 0, sc, sc);
#else
  (void)path; (void)bx; (void)by; (void)bw; (void)bh;
  return false;
#endif
}

bool isJpgName(const String& s) {
  int sl = s.lastIndexOf('/');
  String base = (sl >= 0) ? s.substring(sl + 1) : s;
  if (base.startsWith(".")) return false;
  String low = base;
  low.toLowerCase();
  return low.endsWith(".jpg") || low.endsWith(".jpeg");
}

void scanSdDirForJpg(const char* dirPath) {
#ifdef BOARD_ES3C28P_S3
  if (!sdReady) return;
  File dir = SD_MMC.open(dirPath);
  if (!dir || !dir.isDirectory()) return;
  File f = dir.openNextFile();
  while (f && sdPhotoCount < 64) {
    if (!f.isDirectory()) {
      String fp = String(f.path());
      if (isJpgName(fp)) {
        bool dup = false;
        for (int i = 0; i < sdPhotoCount; i++) if (sdPhotos[i] == fp) { dup = true; break; }
        if (!dup) sdPhotos[sdPhotoCount++] = fp;
      }
    }
    f = dir.openNextFile();
  }
#else
  (void)dirPath;
#endif
}

void scanSdPhotos() {
  sdPhotoCount = 0;
  if (!sdReady) sdReady = initSdCard();
  if (sdReady) {
    scanSdDirForJpg("/photos");
    scanSdDirForJpg("/");
  }
  if (sdPhotoIdx >= sdPhotoCount) sdPhotoIdx = max(0, sdPhotoCount - 1);
}

