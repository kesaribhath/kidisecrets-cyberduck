void drawDiaryCalendar() {
  drawPolkaBg(C_CREAM_BG, C_CREAM_DOT);
  drawRleSprite(8, 5, 18, 18, SPR_HEART_RED);
  drawRleSprite(294, 5, 18, 18, SPR_HEART_RED);

  const char* mNames[12] = {"JAN","FEB","MAR","APR","MAY","JUN","JUL","AUG","SEP","OCT","NOV","DEC"};
  tft.fillRoundRect(34, 4, 22, 20, 5, TFT_WHITE); tft.drawRoundRect(34, 4, 22, 20, 5, C_AMBER);
  tft.fillRoundRect(264, 4, 22, 20, 5, TFT_WHITE); tft.drawRoundRect(264, 4, 22, 20, 5, C_AMBER);
  useFont(FREDOKA_SM);
  tft.setTextDatum(MC_DATUM);
  tft.setTextColor(C_DARK_INK);
  tft.drawString("<", 45, 14);
  tft.drawString(">", 275, 14);

  useFont(FREDOKA_MD);
  char hdr[16];
  snprintf(hdr, sizeof(hdr), "%s, %04d", mNames[calViewMonth - 1], calViewYear);
  tft.drawString(hdr, 160, 14);

  const char* days[7] = {"SUN","MON","TUE","WED","THU","FRI","SAT"};
  useFont(FREDOKA_SM);
  for (int i = 0; i < 7; i++) {
    int x = 10 + i * 43;
    tft.fillRoundRect(x, 28, 39, 16, 4, i == 0 ? 0xFD34 : 0x66BF);
    tft.setTextColor(i == 0 ? 0x7800 : 0x0255);
    tft.drawString(days[i], x + 19, 36);
  }

  int startDow = firstWeekdayOfMonth(calViewYear, calViewMonth);
  int dim = daysInMonth(calViewYear, calViewMonth);
  int cy, cm, cd, hh, mm, dow;
  getCurrentDate(cy, cm, cd, hh, mm, dow);
  long todayInt = dateToInt(cy, cm, cd);

  for (int d = 1; d <= dim; d++) {
    int idx = startDow + (d - 1);
    int r = idx / 7, c = idx % 7;
    if (r >= 5) continue;
    int x = 10 + c * 43, y = 47 + r * 30;
    uint16_t tile = (c == 0) ? 0xFD34 : 0x7E9F;
    tft.fillRoundRect(x, y, 39, 27, 5, tile);
    if (d == selCalDay && calViewYear == curYear && calViewMonth == curMonth) {
      tft.drawRoundRect(x, y, 39, 27, 5, C_DARK_INK);
      tft.drawRoundRect(x + 1, y + 1, 37, 25, 4, C_SUN_YELLOW);
    }

    String k = diaryKeyForDay(calViewYear, calViewMonth, d);
    long unlock = prefs.getLong((k + "u").c_str(), 0);
    if (unlock > todayInt) {
      drawRleSprite(x + 23, y - 2, 16, 16, SPR_LOCK_ICO);
    } else if (hasDiaryTextAll(k)) {
      tft.fillCircle(x + 33, y + 5, 4, C_HEART_RED);
      tft.drawCircle(x + 33, y + 5, 4, TFT_WHITE);
    }

    useFont(FREDOKA_SM);
    tft.setTextColor(C_DARK_INK);
    tft.drawString(String(d), x + 19, y + 14);
  }

  drawRleSprite(10, 212, 22, 22, SPR_BACK_ARR);
  useFont(FREDOKA_SM);
  tft.setTextColor(0x52AA);
  tft.drawString("Tap date to open", 116, 223);

  tft.fillRoundRect(200, 210, 112, 24, 8, C_SUN_YELLOW);
  tft.drawRoundRect(200, 210, 112, 24, 8, C_DARK_INK);
  drawRleSprite(206, 214, 16, 16, SPR_LOCK_ICO);
  tft.setTextColor(C_DARK_INK);
  tft.drawString("Capsules", 268, 222);

  if (lockedPreviewDateInt > 0) {
    drawRedLaceBox(26, 24, 268, 190);
    drawRleSprite(142, 34, 36, 36, SPR_CAP_HRT);
    useFont(FREDOKA_MD);
    tft.setTextDatum(MC_DATUM);
    tft.setTextColor(C_HEART_RED);
    tft.drawString("Capsule Sealed!", 160, 86);
    useFont(FREDOKA_SM);
    tft.setTextColor(C_DARK_INK);
    tft.drawString("Locked until unlock date:", 160, 112);
    tft.fillRoundRect(78, 124, 164, 28, 8, C_SUN_YELLOW);
    tft.drawRoundRect(78, 124, 164, 28, 8, C_AMBER);
    useFont(FREDOKA_MD);
    tft.drawString(fmtDateInt(lockedPreviewDateInt), 160, 138);
    tft.fillRoundRect(118, 164, 84, 30, 8, C_SKY_LACE);
    tft.setTextColor(TFT_WHITE);
    tft.drawString("OK", 160, 179);
  }
}

