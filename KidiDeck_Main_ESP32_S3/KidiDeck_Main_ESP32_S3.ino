void startFlappy() {
  flpY = 90.0f; flpVy = -4.0f; flpPrevY = 90;
  flpPipeX[0] = 240; flpPipeGapY[0] = random(65, 130); flpPipePassed[0] = false;
  flpPipeX[1] = 400; flpPipeGapY[1] = random(65, 130); flpPipePassed[1] = false;
  flpScore = 0; flpState = 0;
  flpLastTick = millis();
}

void drawFlappyHeader() {
  tft.fillRoundRect(184, 3, 128, 22, 6, TFT_WHITE);
  tft.drawRoundRect(184, 3, 128, 22, 6, C_HEART_RED);
  useFont(FREDOKA_SM);
  tft.setTextDatum(MC_DATUM);
  tft.setTextColor(C_HEART_RED);
  tft.drawString("Sc:" + String(flpScore) + " Best:" + String(stBestFlappy), 248, 14);
}

void drawFlappy() {
  tft.fillScreen(C_PINK_BG);
  drawRleSprite(6, 3, 22, 22, SPR_BACK_ARR);
  useFont(FREDOKA_MD);
  tft.setTextDatum(ML_DATUM);
  tft.setTextColor(C_CORAL);
  tft.drawString("Flappy", 34, 14);
  drawFlappyHeader();

  tft.fillRect(10, 32, 300, 198, 0xBFFB);
  tft.drawRect(10, 32, 300, 198, C_SKY_LACE);
  for (int i = 0; i < 2; i++) {
    int px = flpPipeX[i];
    if (px + 24 > 12 && px < 308) {
      int topH = max(4, flpPipeGapY[i] - 32 - 30);
      int botY = flpPipeGapY[i] + 34;
      int drawX = max(12, px);
      int drawW = min(308, px + 24) - drawX;
      if (drawW > 0) {
        tft.fillRect(drawX, 34, drawW, topH, C_HEART_RED);
        if (botY < 228) tft.fillRect(drawX, botY, drawW, 228 - botY, C_HEART_RED);
      }
    }
  }
  tft.fillCircle(64, (int)flpY, 9, C_SUN_YELLOW);
  tft.drawCircle(64, (int)flpY, 9, C_AMBER);
  flpPrevY = (int)flpY;

  if (flpState != 1) {
    drawRedLaceBox(54, 96, 212, 54);
    useFont(FREDOKA_SM);
    tft.setTextDatum(MC_DATUM);
    tft.setTextColor(C_HEART_RED);
    tft.drawString(flpState == 0 ? "Tap Screen to Fly!" : "Score " + String(flpScore) + " · Tap Again!", 160, 123);
  }
}

void flapStar() {
  if (flpState != 1) {
    startFlappy();
    flpState = 1;
    drawFlappy();
    return;
  }
  flpVy = -4.2f;
}

void tickFlappy() {
  if (flpState != 1) return;
  uint32_t now = millis();
  if (now - flpLastTick < 34) return;
  flpLastTick = now;

  flpVy = min(5.4f, flpVy + 0.42f);
  flpY += flpVy;

  if (flpY < 44 || flpY > 218) {
    flpState = 2;
    drawFlappy();
    return;
  }

  tft.fillCircle(64, flpPrevY, 10, 0xBFFB);
  for (int i = 0; i < 2; i++) {
    int oldX = flpPipeX[i];
    flpPipeX[i] -= 3;
    int newX = flpPipeX[i];
    int topH = max(4, flpPipeGapY[i] - 32 - 30);
    int botY = flpPipeGapY[i] + 34;

    if (oldX + 24 >= 12 && oldX < 308) {
      int eraseX = max(12, newX + 24);
      int eraseW = min(308, oldX + 24) - eraseX;
      if (eraseW > 0) {
        tft.fillRect(eraseX, 34, eraseW, topH, 0xBFFB);
        if (botY < 228) tft.fillRect(eraseX, botY, eraseW, 228 - botY, 0xBFFB);
      }
    }
    if (newX < -24) {
      flpPipeX[i] = 312;
      flpPipeGapY[i] = random(72, 168);
      flpPipePassed[i] = false;
    } else if (newX + 24 > 12 && newX < 308) {
      int drawX = max(12, newX);
      int drawW = min(308, newX + 24) - drawX;
      if (drawW > 0) {
        tft.fillRect(drawX, 34, drawW, topH, C_HEART_RED);
        if (botY < 228) tft.fillRect(drawX, botY, drawW, 228 - botY, C_HEART_RED);
      }
    }
    if (!flpPipePassed[i] && flpPipeX[i] + 24 < 55) {
      flpPipePassed[i] = true;
      flpScore++;
      if (flpScore > stBestFlappy) { stBestFlappy = flpScore; prefs.putInt("stFlp", stBestFlappy); }
      drawFlappyHeader();
    }
    if (flpPipeX[i] < 73 && flpPipeX[i] + 24 > 55) {
      if ((int)flpY - 8 < flpPipeGapY[i] - 30 || (int)flpY + 8 > flpPipeGapY[i] + 34) {
        flpState = 2;
        drawFlappy();
        return;
      }
    }
  }
  tft.fillCircle(64, (int)flpY, 9, C_SUN_YELLOW);
  tft.drawCircle(64, (int)flpY, 9, C_AMBER);
  flpPrevY = (int)flpY;
}

