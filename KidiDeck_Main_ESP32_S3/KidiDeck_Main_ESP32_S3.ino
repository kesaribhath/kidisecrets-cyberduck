// ---------------- LOVYANGFX DRIVER (E32R28T AUTO-DETECT XPT2046 + ILI9341) ----------------
class LGFX : public lgfx::LGFX_Device {
  lgfx::Panel_ILI9341 _panel_instance;
  lgfx::Bus_SPI       _bus_instance;
  lgfx::Light_PWM     _light_instance;
#ifdef BOARD_ES3C28P_S3
  lgfx::Touch_FT5x06  _touch_instance;
#else
  lgfx::Touch_XPT2046 _touch_sep; // Official E32R28T separate bus: CLK=25, MOSI=32, MISO=39, CS=33
  lgfx::Touch_XPT2046 _touch_shr; // Shared SPI2_HOST revision: CLK=14, MOSI=13, MISO=12, CS=33
#endif

public:
  LGFX(void) {
#ifdef BOARD_ES3C28P_S3
    {
      auto cfg = _bus_instance.config();
      cfg.spi_host   = SPI2_HOST;
      cfg.spi_mode   = 0;
      cfg.freq_write = 40000000;
      cfg.freq_read  = 16000000;
      cfg.spi_3wire  = false;
      cfg.use_lock   = true;
      cfg.dma_channel = SPI_DMA_CH_AUTO;
      cfg.pin_sclk = 12; cfg.pin_mosi = 11; cfg.pin_miso = 13; cfg.pin_dc = 46;
      _bus_instance.config(cfg);
      _panel_instance.setBus(&_bus_instance);
    }
    {
      auto cfg = _panel_instance.config();
      cfg.pin_cs = 10; cfg.pin_rst = -1; cfg.pin_busy = -1;
      cfg.panel_width = 240; cfg.panel_height = 320;
      cfg.invert = true; cfg.rgb_order = false; cfg.bus_shared = false;
      _panel_instance.config(cfg);
    }
    {
      auto cfg = _light_instance.config();
      cfg.pin_bl = 45; cfg.freq = 44100; cfg.pwm_channel = 7;
      _light_instance.config(cfg);
      _panel_instance.setLight(&_light_instance);
    }
    {
      auto cfg = _touch_instance.config();
      cfg.x_min = 0; cfg.x_max = 239; cfg.y_min = 0; cfg.y_max = 319;
      cfg.pin_int = 17; cfg.pin_rst = 18; cfg.i2c_port = 0; cfg.i2c_addr = 0x38;
      cfg.pin_sda = 16; cfg.pin_scl = 15; cfg.freq = 400000;
      _touch_instance.config(cfg);
      _panel_instance.setTouch(&_touch_instance);
    }
#else
    // --- E32R28T (Yellow PCB ESP32-32E 2.8" ILI9341 + XPT2046) ---
    {
      auto cfg = _bus_instance.config();
      cfg.spi_host   = SPI2_HOST;
      cfg.spi_mode   = 0;
      cfg.freq_write = 40000000;
      cfg.freq_read  = 16000000;
      cfg.spi_3wire  = false;
      cfg.use_lock   = true;
      cfg.dma_channel = SPI_DMA_CH_AUTO;
      cfg.pin_sclk   = 14;
      cfg.pin_mosi   = 13;
      cfg.pin_miso   = 12;
      cfg.pin_dc     = 2;
      _bus_instance.config(cfg);
      _panel_instance.setBus(&_bus_instance);
    }
    {
      auto cfg = _panel_instance.config();
      cfg.pin_cs           = 15;
      cfg.pin_rst          = -1;
      cfg.pin_busy         = -1;
      cfg.panel_width      = 240;
      cfg.panel_height     = 320;
      cfg.invert           = false;
      cfg.rgb_order        = false;
      cfg.bus_shared       = true;
      _panel_instance.config(cfg);
    }
    {
      auto cfg = _light_instance.config();
      cfg.pin_bl      = 21;
      cfg.invert      = false;
      cfg.freq        = 44100;
      cfg.pwm_channel = 7;
      _light_instance.config(cfg);
      _panel_instance.setLight(&_light_instance);
    }
    {
      auto cfg = _touch_sep.config();
      cfg.x_min      = 250; cfg.x_max = 3850;
      cfg.y_min      = 250; cfg.y_max = 3850;
      cfg.pin_int    = -1;
      cfg.bus_shared = false;
      cfg.offset_rotation = 0;
      cfg.spi_host   = -1;
      cfg.freq       = 1000000;
      cfg.pin_sclk   = 25;
      cfg.pin_mosi   = 32;
      cfg.pin_miso   = 39;
      cfg.pin_cs     = 33;
      _touch_sep.config(cfg);
    }
    {
      auto cfg = _touch_shr.config();
      cfg.x_min      = 250; cfg.x_max = 3850;
      cfg.y_min      = 250; cfg.y_max = 3850;
      cfg.pin_int    = -1;
      cfg.bus_shared = true;
      cfg.offset_rotation = 0;
      cfg.spi_host   = SPI2_HOST;
      cfg.freq       = 1000000;
      cfg.pin_sclk   = 14;
      cfg.pin_mosi   = 13;
      cfg.pin_miso   = 12;
      cfg.pin_cs     = 33;
      _touch_shr.config(cfg);
    }
    _panel_instance.setTouch(&_touch_sep);
#endif
    setPanel(&_panel_instance);
  }

#ifndef BOARD_ES3C28P_S3
  void initAllTouchBuses() {
    _touch_sep.init();
    _touch_shr.init();
  }
  void selectTouchBus(uint8_t mode) {
    if (mode == 0) _panel_instance.setTouch(&_touch_sep);
    else           _panel_instance.setTouch(&_touch_shr);
  }
#endif
};

