void startBricks() {
  for (int i = 0; i < 24; i++) brkAlive[i] = true;
  brkPadX = 124; brkPrevPadX = 124;
  brkBx = 155.0f; brkBy = 165.0f; brkVx = 2.6f; brkVy = -2.9f;
  brkPrevBx = 155; brkPrevBy = 165;
  brkScore = 0; brkOver = false;
  brkLastTick = millis();
}

void drawBricksHeader() {
  tft.fillRoundRect(184, 3, 128, 22, 6, TFT_WHITE);
  tft.drawRoundRect(184, 3, 128, 22, 6, C_HEART_RED);
  useFont(FREDOKA_SM);
  tft.setTextDatum(MC_DATUM);
  tft.setTextColor(C_HEART_RED);
  tft.drawString("Sc:" + String(brkScore) + " Best:" + String(stBestBricks), 248, 14);
}

void drawBricks() {
  const uint16_t bCols[4] = {C_HEART_RED, C_AMBER, C_SKY_LACE, C_GREEN_OK};
  tft.fillScreen(C_PINK_BG);
  drawRleSprite(6, 3, 22, 22, SPR_BACK_ARR);
  useFont(FREDOKA_MD);
  tft.setTextDatum(ML_DATUM);
  tft.setTextColor(C_CORAL);
  tft.drawString("Bricks", 34, 14);
  drawBricksHeader();

  tft.fillRect(10, 32, 300, 198, C_DARK_INK);
  tft.drawRect(10, 32, 300, 198, C_SKY_LACE);
  for (int i = 0; i < 24; i++) {
    if (!brkAlive[i]) continue;
    int r = i / 6, c = i % 6;
    tft.fillRoundRect(16 + c * 48, 40 + r * 16, 44, 12, 3, bCols[r]);
  }
  tft.fillRoundRect(brkPadX, 212, 64, 9, 4, C_SKY_LACE);
  tft.fillCircle((int)brkBx, (int)brkBy, 5, C_SUN_YELLOW);
  brkPrevPadX = brkPadX; brkPrevBx = (int)brkBx; brkPrevBy = (int)brkBy;

  if (brkOver) {
    drawRedLaceBox(54, 96, 212, 60);
    useFont(FREDOKA_SM);
    tft.setTextDatum(MC_DATUM);
    tft.setTextColor(C_HEART_RED);
    tft.drawString("Score: " + String(brkScore), 160, 114);
    tft.setTextColor(C_DARK_INK);
    tft.drawString("Tap screen to Play Again", 160, 134);
  }
}

void moveBricksPaddle(int targetX) {
  int nextP = constrain(targetX - 32, 14, 242);
  if (nextP == brkPadX) return;
  tft.fillRect(brkPrevPadX, 212, 64, 9, C_DARK_INK);
  brkPadX = nextP;
  brkPrevPadX = nextP;
  tft.fillRoundRect(brkPadX, 212, 64, 9, 4, C_SKY_LACE);
}

void tickBricks() {
  if (brkOver) return;
  uint32_t now = millis();
  if (now - brkLastTick < 28) return;
  brkLastTick = now;

  tft.fillCircle(brkPrevBx, brkPrevBy, 6, C_DARK_INK);
  brkBx += brkVx; brkBy += brkVy;
  if (brkBx <= 17 || brkBx >= 303) { brkVx = -brkVx; brkBx = constrain(brkBx, 17.0f, 303.0f); }
  if (brkBy <= 39) { brkVy = fabs(brkVy); brkBy = 39.0f; }

  if (brkVy > 0 && brkBy >= 207 && brkBy <= 216 && brkBx >= brkPadX - 4 && brkBx <= brkPadX + 68) {
    brkVy = -fabs(brkVy);
    brkVx += ((brkBx - (brkPadX + 32)) / 32.0f) * 1.1f;
    brkVx = constrain(brkVx, -4.5f, 4.5f);
    tft.fillRoundRect(brkPadX, 212, 64, 9, 4, C_SKY_LACE);
  }
  if (brkBy > 224) {
    brkOver = true;
    drawBricks();
    return;
  }

  for (int i = 0; i < 24; i++) {
    if (!brkAlive[i]) continue;
    int r = i / 6, c = i % 6;
    int bx = 16 + c * 48, by = 40 + r * 16;
    if (brkBx + 5 >= bx && brkBx - 5 <= bx + 44 && brkBy + 5 >= by && brkBy - 5 <= by + 12) {
      brkAlive[i] = false;
      tft.fillRect(bx, by, 44, 12, C_DARK_INK);
      brkVy = -brkVy;
      brkScore += 10;
      if (brkScore > stBestBricks) { stBestBricks = brkScore; prefs.putInt("stBrk", stBestBricks); }
      drawBricksHeader();
      bool allClear = true;
      for (int k = 0; k < 24; k++) if (brkAlive[k]) { allClear = false; break; }
      if (allClear) {
        for (int k = 0; k < 24; k++) brkAlive[k] = true;
        brkVy = (brkVy < 0) ? brkVy - 0.3f : brkVy + 0.3f;
        drawBricks();
        return;
      }
      break;
    }
  }
  tft.fillCircle((int)brkBx, (int)brkBy, 5, C_SUN_YELLOW);
  brkPrevBx = (int)brkBx; brkPrevBy = (int)brkBy;
}

// ---------- 4. MEMORY MATCH ----------
void startMatch() {
  for (int i = 0; i < 12; i++) { mchCards[i] = i / 2; mchMatched[i] = false; }
  for (int i = 11; i > 0; i--) {
    int j = random(0, i + 1);
    int tmp = mchCards[i]; mchCards[i] = mchCards[j]; mchCards[j] = tmp;
  }
  mchOpenA = -1; mchOpenB = -1; mchMoves = 0; mchWon = false; mchHideAt = 0;
}

void drawMatchSymbol(int cx, int cy, int sym) {
  if (sym == 0) {
    tft.fillCircle(cx - 4, cy - 2, 5, C_HEART_RED);
    tft.fillCircle(cx + 4, cy - 2, 5, C_HEART_RED);
    tft.fillTriangle(cx - 9, cy, cx + 9, cy, cx, cy + 9, C_HEART_RED);
  } else if (sym == 1) {
    tft.fillTriangle(cx, cy - 9, cx - 8, cy + 6, cx + 8, cy + 6, C_AMBER);
    tft.fillTriangle(cx, cy + 9, cx - 8, cy - 4, cx + 8, cy - 4, C_SUN_YELLOW);
  } else if (sym == 2) {
    tft.fillCircle(cx - 5, cy + 4, 5, 0xE084);
    tft.fillCircle(cx + 5, cy + 4, 5, C_HEART_RED);
    tft.drawFastVLine(cx - 4, cy - 7, 8, C_GREEN_OK);
    tft.drawFastVLine(cx + 4, cy - 7, 8, C_GREEN_OK);
  } else if (sym == 3) {
    tft.fillCircle(cx, cy, 8, C_SKY_LACE);
    tft.fillCircle(cx + 4, cy - 2, 6, 0xFEF0);
  } else if (sym == 4) {
    tft.fillTriangle(cx - 9, cy + 6, cx - 6, cy - 6, cx, cy + 6, C_AMBER);
    tft.fillTriangle(cx - 4, cy + 6, cx, cy - 8, cx + 4, cy + 6, C_SUN_YELLOW);
    tft.fillTriangle(cx, cy + 6, cx + 6, cy - 6, cx + 9, cy + 6, C_AMBER);
  } else {
    tft.fillCircle(cx - 5, cy, 4, 0xA29E);
    tft.fillCircle(cx + 5, cy, 4, 0xA29E);
    tft.fillCircle(cx, cy - 5, 4, 0xA29E);
    tft.fillCircle(cx, cy + 5, 4, 0xA29E);
    tft.fillCircle(cx, cy, 4, C_SUN_YELLOW);
  }
}

void drawMatch() {
  drawPolkaBg(C_PINK_BG, 0xFFF2);
  drawRleSprite(10, 6, 22, 22, SPR_BACK_ARR);
  useFont(FREDOKA_MD);
  tft.setTextDatum(MC_DATUM);
  tft.setTextColor(C_CORAL);
  tft.drawString("Memory Match", 150, 17);

  useFont(FREDOKA_SM);
  tft.fillRoundRect(242, 6, 70, 22, 7, TFT_WHITE);
  tft.drawRoundRect(242, 6, 70, 22, 7, C_HEART_RED);
  tft.setTextColor(C_DARK_INK);
  tft.drawString("Shuffle", 277, 17);

  for (int i = 0; i < 12; i++) {
    int r = i / 4, c = i % 4;
    int bx = 26 + c * 69, by = 36 + r * 58;
    bool open = mchMatched[i] || i == mchOpenA || i == mchOpenB;
    uint16_t bg = mchMatched[i] ? 0xDFBB : open ? 0xFEF0 : TFT_WHITE;
    uint16_t br = mchMatched[i] ? C_GREEN_OK : open ? C_AMBER : C_HEART_RED;
    tft.fillRoundRect(bx, by, 60, 50, 8, bg);
    tft.drawRoundRect(bx, by, 60, 50, 8, br);
    if (open) {
      drawMatchSymbol(bx + 30, by + 25, mchCards[i]);
    } else {
      drawRleSprite(bx + 21, by + 16, 18, 18, SPR_HEART_RED);
    }
  }

  tft.setTextColor(C_DARK_INK);
  tft.drawString(mchWon ? "Cleared! Tap Shuffle to play again" : "Moves: " + String(mchMoves) + "  Wins: " + String(stMatchWins), 160, 224);
}

void tickActiveGame() {
  if (curScreen == SCR_SNAKE) tickSnake();
  else if (curScreen == SCR_FLAPPY) tickFlappy();
  else if (curScreen == SCR_BRICKS) tickBricks();
  else if (curScreen == SCR_MATCH && mchHideAt > 0 && millis() >= mchHideAt) {
    mchHideAt = 0; mchOpenA = -1; mchOpenB = -1;
    drawMatch();
  }
}

