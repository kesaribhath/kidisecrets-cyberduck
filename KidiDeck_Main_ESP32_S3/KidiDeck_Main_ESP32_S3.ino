// ---------- 1. SNAKE ----------
void spawnSnakeFood() {
  for (int t = 0; t < 40; t++) {
    int fx = random(0, 15), fy = random(0, 11);
    bool hit = false;
    for (int i = 0; i < snkLen; i++) if (snkX[i] == fx && snkY[i] == fy) { hit = true; break; }
    if (!hit) { snkFoodX = fx; snkFoodY = fy; return; }
  }
}

void startSnake() {
  snkLen = 3;
  snkX[0] = 6; snkY[0] = 5;
  snkX[1] = 5; snkY[1] = 5;
  snkX[2] = 4; snkY[2] = 5;
  snkDx = 1; snkDy = 0; snkNextDx = 1; snkNextDy = 0;
  snkScore = 0; snkDead = false;
  snkLastTick = millis();
  spawnSnakeFood();
}

void drawSnakeScore() {
  tft.fillRoundRect(222, 48, 88, 36, 7, TFT_WHITE);
  tft.drawRoundRect(222, 48, 88, 36, 7, C_HEART_RED);
  useFont(FREDOKA_SM);
  tft.setTextDatum(MC_DATUM);
  tft.setTextColor(0x52AA);
  tft.drawString("BEST " + String(stBestSnake), 266, 57);
  tft.setTextColor(C_GREEN_OK);
  tft.drawString("SCORE " + String(snkScore), 266, 73);
}

void drawSnake() {
  drawPolkaBg(C_PINK_BG, 0xFFF2);
  tft.fillRoundRect(10, 32, 201, 149, 8, 0xEF7A);
  tft.drawRoundRect(10, 32, 201, 149, 8, 0x24E3);
  for (int i = snkLen - 1; i >= 0; i--) {
    int cx = 13 + snkX[i] * 13, cy = 35 + snkY[i] * 13;
    tft.fillRoundRect(cx, cy, 11, 11, 3, i == 0 ? 0x1482 : C_GREEN_OK);
  }
  tft.fillCircle(18 + snkFoodX * 13, 40 + snkFoodY * 13, 5, C_HEART_RED);

  drawRleSprite(222, 10, 22, 22, SPR_BACK_ARR);
  useFont(FREDOKA_MD);
  tft.setTextDatum(ML_DATUM);
  tft.setTextColor(C_CORAL);
  tft.drawString("Snake", 250, 21);
  drawSnakeScore();

  useFont(FREDOKA_SM);
  tft.setTextDatum(MC_DATUM);
  tft.setTextColor(C_DARK_INK);
  tft.fillRoundRect(252, 92, 28, 26, 6, TFT_WHITE); tft.drawString("^", 266, 105);
  tft.fillRoundRect(222, 122, 28, 26, 6, TFT_WHITE); tft.drawString("<", 236, 135);
  tft.fillRoundRect(252, 122, 28, 26, 6, TFT_WHITE); tft.drawString("v", 266, 135);
  tft.fillRoundRect(282, 122, 28, 26, 6, TFT_WHITE); tft.drawString(">", 296, 135);

  tft.fillRoundRect(222, 188, 88, 30, 8, C_GREEN_OK);
  tft.setTextColor(TFT_WHITE);
  tft.drawString("New Run", 266, 203);

  if (snkDead) {
    drawRedLaceBox(36, 76, 150, 62);
    tft.setTextColor(C_HEART_RED);
    tft.drawString("Game Over!", 111, 98);
    tft.setTextColor(C_DARK_INK);
    tft.drawString("Tap New Run", 111, 118);
  }
}

void turnSnake(int dx, int dy) {
  if (snkDx == -dx && snkDy == -dy) return;
  snkNextDx = dx; snkNextDy = dy;
}

void tickSnake() {
  if (snkDead) return;
  uint32_t now = millis();
  uint32_t stepMs = (uint32_t)max(105, 220 - snkScore * 6);
  if (now - snkLastTick < stepMs) return;
  snkLastTick = now;

  snkDx = snkNextDx; snkDy = snkNextDy;
  int nx = (snkX[0] + snkDx + 15) % 15;
  int ny = (snkY[0] + snkDy + 11) % 11;
  for (int i = 0; i < snkLen; i++) {
    if (snkX[i] == nx && snkY[i] == ny) {
      snkDead = true;
      drawRedLaceBox(36, 76, 150, 62);
      useFont(FREDOKA_SM);
      tft.setTextDatum(MC_DATUM);
      tft.setTextColor(C_HEART_RED);
      tft.drawString("Game Over!", 111, 98);
      tft.setTextColor(C_DARK_INK);
      tft.drawString("Tap New Run", 111, 118);
      return;
    }
  }
  bool ate = (nx == snkFoodX && ny == snkFoodY);
  int oldTailX = snkX[snkLen - 1], oldTailY = snkY[snkLen - 1];
  int prevHeadX = snkX[0], prevHeadY = snkY[0];
  if (ate && snkLen < 160) snkLen++;
  for (int i = snkLen - 1; i > 0; i--) { snkX[i] = snkX[i - 1]; snkY[i] = snkY[i - 1]; }
  snkX[0] = nx; snkY[0] = ny;

  if (!ate) tft.fillRect(13 + oldTailX * 13, 35 + oldTailY * 13, 12, 12, 0xEF7A);
  tft.fillRoundRect(13 + prevHeadX * 13, 35 + prevHeadY * 13, 11, 11, 3, C_GREEN_OK);
  tft.fillRoundRect(13 + nx * 13, 35 + ny * 13, 11, 11, 3, 0x1482);
  if (ate) {
    snkScore++;
    if (snkScore > stBestSnake) { stBestSnake = snkScore; prefs.putInt("stSnk", stBestSnake); }
    spawnSnakeFood();
    tft.fillCircle(18 + snkFoodX * 13, 40 + snkFoodY * 13, 5, C_HEART_RED);
    drawSnakeScore();
  }
}

